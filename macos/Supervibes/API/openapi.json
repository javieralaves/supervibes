{
  "openapi": "3.0.3",
  "info": {
    "title": "Supervibes",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "The session token from the Mac app's sign-in (see lib/native-auth.ts)."
      }
    },
    "schemas": {
      "Connections": {
        "type": "object",
        "properties": {
          "connections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Connection"
            }
          }
        },
        "required": [
          "connections"
        ]
      },
      "Connection": {
        "type": "object",
        "properties": {
          "provider": {
            "$ref": "#/components/schemas/Provider"
          },
          "label": {
            "type": "string",
            "example": "Linear"
          },
          "description": {
            "type": "string",
            "example": "Issues, projects and cycles."
          },
          "configured": {
            "type": "boolean",
            "description": "false until the server has this app's credentials."
          },
          "connection": {
            "type": "object",
            "nullable": true,
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "connected",
                  "error"
                ]
              },
              "lastError": {
                "type": "string",
                "nullable": true
              },
              "connectedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "status",
              "lastError",
              "connectedAt"
            ],
            "description": "null when not connected."
          }
        },
        "required": [
          "provider",
          "label",
          "description",
          "configured",
          "connection"
        ]
      },
      "Provider": {
        "type": "string",
        "enum": [
          "linear",
          "github",
          "granola"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "not_found"
              },
              "message": {
                "type": "string",
                "example": "That block doesn't exist anymore."
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "ConnectionStart": {
        "type": "object",
        "properties": {
          "authorizationUrl": {
            "type": "string",
            "format": "uri"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "authorizationUrl",
          "state"
        ]
      },
      "ConnectionComplete": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "state",
          "code"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "image": {
                "type": "string",
                "nullable": true
              }
            },
            "required": [
              "id",
              "email",
              "name",
              "image"
            ]
          },
          "settings": {
            "type": "object",
            "properties": {
              "sleepStart": {
                "type": "integer",
                "description": "Bedtime, minutes after local midnight."
              },
              "wakeTime": {
                "type": "integer",
                "description": "Wake-up time, minutes after local midnight."
              },
              "clock": {
                "type": "string",
                "nullable": true,
                "enum": [
                  "12h",
                  "24h",
                  null
                ],
                "description": "null follows the device."
              },
              "timeZone": {
                "type": "string",
                "nullable": true,
                "description": "As the web app last reported it."
              }
            },
            "required": [
              "sleepStart",
              "wakeTime",
              "clock",
              "timeZone"
            ]
          }
        },
        "required": [
          "user",
          "settings"
        ]
      },
      "Settings": {
        "type": "object",
        "properties": {
          "sleepStart": {
            "type": "integer",
            "description": "Bedtime, minutes after local midnight, on the quarter hour."
          },
          "wakeTime": {
            "type": "integer",
            "description": "Wake-up time, minutes after local midnight, on the quarter hour."
          },
          "clock": {
            "type": "string",
            "nullable": true,
            "enum": [
              "12h",
              "24h",
              null
            ],
            "description": "null follows the device."
          }
        },
        "required": [
          "sleepStart",
          "wakeTime",
          "clock"
        ]
      },
      "Today": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "description": "The calendar day, in `timeZone`."
          },
          "timeZone": {
            "type": "string"
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TodayBlock"
            },
            "description": "Every block that overlaps the day, earliest first."
          }
        },
        "required": [
          "day",
          "timeZone",
          "blocks"
        ]
      },
      "TodayBlock": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "intention",
              "protected"
            ],
            "description": "An intention schedules a task; protected time is held for the goal."
          },
          "title": {
            "type": "string",
            "nullable": true,
            "description": "null for protected time without a name; show the goal's title."
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "For protected time: what the session is for."
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "taskId": {
            "type": "string",
            "nullable": true
          },
          "taskDone": {
            "type": "boolean"
          },
          "hasAgenda": {
            "type": "boolean"
          },
          "goal": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "color": {
                "$ref": "#/components/schemas/GoalColor"
              }
            },
            "required": [
              "id",
              "title",
              "color"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "description",
          "startsAt",
          "endsAt",
          "taskId",
          "taskDone",
          "hasAgenda",
          "goal"
        ]
      },
      "GoalColor": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "example": "violet"
          },
          "light": {
            "type": "string",
            "description": "Hex for light mode.",
            "example": "#8b3df0"
          },
          "dark": {
            "type": "string",
            "description": "Hex for dark mode.",
            "example": "#b88bff"
          }
        },
        "required": [
          "key",
          "light",
          "dark"
        ]
      },
      "Usage": {
        "type": "object",
        "properties": {
          "days": {
            "type": "integer",
            "description": "How many days back `calls` goes."
          },
          "calls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UsageCall"
            },
            "description": "Newest first. Days are the viewer's to work out."
          }
        },
        "required": [
          "days",
          "calls"
        ]
      },
      "UsageCall": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "feature": {
            "type": "string",
            "enum": [
              "progress_read",
              "recap",
              "agenda"
            ]
          },
          "trigger": {
            "type": "string",
            "enum": [
              "manual",
              "note",
              "recap",
              "cron",
              "draft",
              "redraft",
              "auto"
            ]
          },
          "goalTitle": {
            "type": "string",
            "nullable": true
          },
          "model": {
            "type": "string"
          },
          "inputTokens": {
            "type": "integer",
            "description": "All input tokens: uncached, cache reads and cache writes."
          },
          "outputTokens": {
            "type": "integer"
          },
          "toolCalls": {
            "type": "integer"
          },
          "durationMs": {
            "type": "integer"
          },
          "outcome": {
            "type": "string"
          },
          "cost": {
            "type": "number",
            "nullable": true,
            "description": "Dollars, or null for a model without a known price."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "feature",
          "trigger",
          "goalTitle",
          "model",
          "inputTokens",
          "outputTokens",
          "toolCalls",
          "durationMs",
          "outcome",
          "cost",
          "createdAt"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/connections": {
      "get": {
        "operationId": "listConnections",
        "summary": "Every app Supervibes can read from, and whether it's connected",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Connections"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the session ended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/connections/{provider}/start": {
      "post": {
        "operationId": "startConnection",
        "summary": "Begin connecting an app: open `authorizationUrl` in the system sign-in sheet",
        "description": "The provider sends the sheet back to supervibes://connections with `state` and `code` (or `error`); pass them to complete.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/Provider"
            },
            "required": true,
            "name": "provider",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionStart"
                }
              }
            }
          },
          "400": {
            "description": "The request didn't make sense.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the session ended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/connections/{provider}/complete": {
      "post": {
        "operationId": "completeConnection",
        "summary": "Finish connecting an app with the code the sign-in sheet came back with",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/Provider"
            },
            "required": true,
            "name": "provider",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectionComplete"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Connection"
                }
              }
            }
          },
          "400": {
            "description": "The request didn't make sense.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the session ended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/connections/{provider}": {
      "delete": {
        "operationId": "disconnect",
        "summary": "Disconnect an app. Goal sources that use it are removed.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/Provider"
            },
            "required": true,
            "name": "provider",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Disconnected"
          },
          "401": {
            "description": "Not signed in, or the session ended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "getMe",
        "summary": "The signed-in person and their settings",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the session ended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settings": {
      "put": {
        "operationId": "putSettings",
        "summary": "Save the sleep schedule and clock",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Settings"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "400": {
            "description": "The request didn't make sense.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the session ended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/today": {
      "get": {
        "operationId": "getToday",
        "summary": "Today's blocks, for the menu bar, widgets and notifications",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "The device's time zone. Defaults to the one the web app last reported, then UTC.",
              "example": "Europe/Madrid"
            },
            "required": false,
            "description": "The device's time zone. Defaults to the one the web app last reported, then UTC.",
            "name": "timeZone",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Today"
                }
              }
            }
          },
          "400": {
            "description": "The request didn't make sense.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the session ended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/usage": {
      "get": {
        "operationId": "getUsage",
        "summary": "What calls to Claude cost over the last 30 days",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usage"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the session ended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
