// Shared by every target and configuration.

// The app's identity. Debug builds are a separate app ("Supervibes Dev", .debug) so they can run
// next to an installed Release build without macOS mixing up their widgets, menu bar and settings.
SUPERVIBES_BUNDLE_ID = com.supervibes.mac
SUPERVIBES_DISPLAY_NAME = Supervibes

// Signing. Without a certificate, builds are signed ad hoc ("Sign to Run Locally"), which runs on
// this Mac. To sign with your Apple Developer team, create Config/Signing.local.xcconfig
// (gitignored; scripts/release.sh writes it once a certificate is in the Keychain) with:
//   CODE_SIGN_STYLE = Automatic
//   CODE_SIGN_IDENTITY = Apple Development
//   DEVELOPMENT_TEAM = <your team id>
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
